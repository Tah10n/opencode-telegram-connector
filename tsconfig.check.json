{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.mjs",
    "index.mjs",
    "connector.config.example.mjs"
  ]
}
